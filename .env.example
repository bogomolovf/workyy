# Copy this file to .env files in respective apps

# Backend (apps/realtime-server/.env)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/workyy
PORT=4000

# Frontend (apps/web/.env.local)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=90bcfc0f-049f-42f4-8398-fc1c52c399a8
NEXT_PUBLIC_DEMO_BOARD_ID=bc9dba15-8125-42c4-b6e3-05097e005fd8

# WebRTC (audio calls) — STUN/TURN servers
# Google STUN is free and works for development; add TURN for production
NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]'
# For production, add a TURN server (e.g. Twilio, Cloudflare, self-hosted coturn):
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'
