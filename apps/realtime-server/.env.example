# Workyy Realtime Server (Fastify) Environment Variables

# Server port
PORT=4000

# PostgreSQL database connection string
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/workyy

# Redis connection string (optional, for future use)
REDIS_URL=redis://redis:6379

# CORS origins - URLs allowed to make requests to this API
# Landing page origin
LANDING_ORIGIN=http://localhost:5173

# Product app origin (Next.js)
APP_ORIGIN=http://localhost:3000

# Auth0 configuration (TODO: implement authentication)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.workyy.dev
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me

# OpenTelemetry endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# JWT Authentication
JWT_SECRET=change-me-in-prod
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_EXPIRES_IN=3600
BCRYPT_ROUNDS=11
