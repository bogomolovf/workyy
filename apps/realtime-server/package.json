{
  "name": "realtime-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/index.ts\"",
    "build": "tsup src/index.ts --format esm --dts --out-dir dist",
    "start": "node dist/index.js",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.16.0",
    "@fastify/cookie": "^9.0.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/jwt": "^6.0.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^8.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^8.3.0",
    "@prisma/client": "^5.17.0",
    "@types/pg": "^8.15.6",
    "@workyy/core-domain": "workspace:*",
    "@workyy/dag-executor": "workspace:*",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "fastify": "^4.27.2",
    "lib0": "^0.2.93",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.1",
    "oracledb": "^6.7.0",
    "pg": "^8.16.3",
    "pino": "^9.4.0",
    "ws": "^8.17.1",
    "y-websocket": "^1.5.3",
    "yjs": "^13.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/mssql": "^9.1.9",
    "@types/ws": "^8.5.10",
    "eslint": "^9.3.0",
    "prisma": "^5.22.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
