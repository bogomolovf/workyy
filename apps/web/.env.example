# Workyy Product (Next.js) Environment Variables

# URL of the Workyy Landing page
# In production with Nginx, this should be: https://workyy.example.com
# In development, this is: http://localhost:5173
NEXT_PUBLIC_LANDING_URL=http://localhost:5173

# URL of the Workyy backend API (Fastify realtime-server)
# In production with Nginx, this should be: https://workyy.example.com
# (Nginx will proxy /api/* to the backend)
# In development, this is: http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# URL of this Next.js application
# In production with Nginx, this should be: https://workyy.example.com/app
# In development, this is: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default workspace ID for creating boards (optional)
# If not set, will use the first available workspace
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=

# Demo board ID for /board/demo route (optional)
NEXT_PUBLIC_DEMO_BOARD_ID=
